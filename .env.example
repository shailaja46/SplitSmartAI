# ====================================================================
# SplitSmart AI — Environment Variables
# Copy this file to .env.local and populate with your own credentials.
# ====================================================================

# Supabase PostgreSQL & Auth Configuration
# Obtain from: https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Service Role key for administrative scripts (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini API Configuration (Official Google Gen AI SDK)
# Obtain free from: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key

# Configurable Gemini model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
